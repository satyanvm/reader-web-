---
// "Check your email" step, shared by sign-up and sign-in (an unconfirmed
// account gets a fresh code when it tries to sign in).
---

<div data-step="code" hidden>
  <h1 tabindex="-1">Check your email</h1>
  <p class="lead">
    We sent a 6-digit code to <strong data-email-out></strong>. It expires in 10 minutes.
  </p>
  <form novalidate>
    <div class="field">
      <label for="code">Code</label>
      <input
        id="code"
        name="code"
        class="code-input"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        maxlength="6"
        pattern="[0-9]{6}"
        required
      />
    </div>
    <p class="form-error" role="alert" hidden></p>
    <button class="btn btn-primary btn-block" type="submit">Confirm email</button>
    <p class="hint">
      Didn’t get it? Check your spam folder, or <button type="button" class="link-btn" data-resend>send a new code</button>.
    </p>
    <p class="form-note" data-resent role="status" hidden>A new code is on its way.</p>
  </form>
  <p class="auth-foot"><button type="button" class="link-btn" data-back>Use a different email</button></p>
</div>
