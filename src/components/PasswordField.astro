---
interface Props {
  id: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  hint?: string;
}
const { id, label, autocomplete, hint } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="field">
  <div class="label-row">
    <label for={id}>{label}</label>
    <slot name="label-extra" />
  </div>
  <div class="input-wrap">
    <input
      id={id}
      name="password"
      type="password"
      autocomplete={autocomplete}
      required
      minlength={autocomplete === 'new-password' ? 8 : undefined}
      aria-describedby={hintId}
    />
    <button type="button" class="reveal-pw" aria-pressed="false" aria-label={`Show ${label.toLowerCase()}`}>Show</button>
  </div>
  {hint && <p id={hintId} class="hint">{hint}</p>}
</div>
