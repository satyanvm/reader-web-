// readserene.site runs as the `readserene` Worker: dist/ as static assets, plus
// server/worker.ts for /api/* and /download/*. Cloudflare Workers Builds deploys
// it from Git with `npx wrangler deploy`, which reads this file; Wrangler runs the
// build itself, so dist/ exists even when the dashboard has no build command set.
{
  "name": "readserene",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status, as on Pages.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/download/*"]
  },
  "routes": [
    { "pattern": "readserene.site", "custom_domain": true },
    { "pattern": "www.readserene.site", "custom_domain": true }
  ],
  // Pull request builds run `npx wrangler preview`, which needs this block.
  "previews": {}
}
