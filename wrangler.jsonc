// Cloudflare Workers Builds deploys the site with `npx wrangler deploy`, which
// reads this file. Wrangler runs the build itself, so dist/ exists even when
// the dashboard has no build command set.
{
  "name": "readserene",
  "compatibility_date": "2026-10-01",
  "main": "server/worker.ts",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status, as on Pages.
    "not_found_handling": "404-page",
    // Static files never reach the Worker; only the account proxy does.
    "run_worker_first": ["/api/*"]
  },
  // Pull request builds run `npx wrangler preview`, which needs this block.
  "previews": {}
}
